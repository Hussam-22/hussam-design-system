{
  "name": "@hussam-22/design-system",
  "version": "0.1.0",
  "type": "module",
  "description": "Portable components, visual recipes and Codex skills extracted from Hussam\u2019s portfolio.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hussam-22/hussam-design-system.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/hds.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib && npm run build:gallery",
    "build:lib": "vite build && tsc -p tsconfig.lib.json",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.0.0",
    "prettier": "^3.9.9",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.58.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
